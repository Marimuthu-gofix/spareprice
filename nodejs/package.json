{
  "name": "spareprice",
  "version": "1.0.0",
  "description": "Mobile spare-part price tracker: scraper (Playwright) and dashboard (Express), Node.js edition",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/dashboard/server.js",
    "scrape": "node src/scraper/cli.js",
    "discover": "node src/scraper/cli.js discover-all",
    "push-history": "node src/scraper/cli.js push-history",
    "postinstall": "node -e \"process.exit(0)\""
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "nunjucks": "^3.2.4",
    "playwright": "1.63.0"
  }
}
