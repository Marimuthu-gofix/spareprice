# Settings for running on a PC. Copy this file to `.env` (same folder) and
# fill in the values. `.env` is ignored by git and is never deployed.

# The live price store. With both set, the dashboard shows the live data
# and every scrape, from the page or the command line, is also sent there.
# Remove them (or the whole file) to work with the local file only.
PRICE_API_URL=https://scrape.gofix.info/api
PRICE_API_KEY=your-long-random-key
